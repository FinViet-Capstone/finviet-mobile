# Backend base URL (no trailing slash). Routes are /api/*.
#   Android emulator uses 10.0.2.2; a physical device needs your LAN IP.
EXPO_PUBLIC_API_BASE_URL= http://<your-LAN-IP>:backend-port/api

# Firebase — get from google-services.json / GoogleService-Info.plist
EXPO_PUBLIC_FCM_SENDER_ID=

# Google Sign-In (src/lib/googleAuth.ts). Both come from the Firebase project's
# google-services.json and are public by design — they ship inside the binary.
#   client ID : the `client_type: 3` (web) entry under oauth_client
#   api key   : client[].api_key[0].current_key
# Android also needs the build's signing SHA-1 registered on the Firebase app
# (Project settings → Android app → Add fingerprint), otherwise sign-in fails
# with DEVELOPER_ERROR (code 10) after you pick an account.
# The debug build is signed by android/app/debug.keystore (see signingConfigs
# in android/app/build.gradle) — NOT ~/.android/debug.keystore. android/ is
# gitignored, so each checkout has its own; register every one, plus EAS's:
#   keytool -list -v -keystore android/app/debug.keystore \
#     -alias androiddebugkey -storepass android
# Requires a dev build; not Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=

# Cloudinary (for avatar/photo uploads if handled client-side)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# SePay OAuth2 (for linked wallet integration)
# Register your app at developer.sepay.vn to get client_id.
# client_secret stays server-side only (never exposed to the mobile app).
EXPO_PUBLIC_SEPAY_CLIENT_ID=

# Sentry crash reporting DSN. Get from sentry.io project settings.
# Leave empty to disable Sentry entirely (e.g. local dev).
EXPO_PUBLIC_SENTRY_DSN=
