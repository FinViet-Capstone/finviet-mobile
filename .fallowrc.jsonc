{
  // FinViet Mobile — fallow configuration.

  "rules": {
    // OFF by design: src/services/index.ts is a barrel that re-exports every
    // domain function from src/services/real/* under the same name, by
    // design (screens/hooks import only from the barrel — see
    // context/architecture.md). That's an intentional barrel re-export
    // pattern, not accidental duplication, and it's the overwhelming
    // majority of what this rule flags here.
    "duplicate-exports": "off"
  },

  // Don't flag an export whose only consumers are in its own defining file
  // (e.g. an interface used locally but still marked `export`). These are
  // stylistic, not dead code.
  "ignoreExportsUsedInFile": true
}
