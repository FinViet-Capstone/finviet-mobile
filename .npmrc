# Expo SDK 54's expo-router pulls in react-dom as an optional peer (web support,
# via vaul/@radix-ui) that wants react@^19.2.8, conflicting with this project's
# pinned react@19.1.0. legacy-peer-deps avoids that ERESOLVE conflict without
# bumping react. Must be committed here (not just in a personal ~/.npmrc) so
# `npm ci` behaves the same in EAS's clean build containers as it does locally.
legacy-peer-deps=true
